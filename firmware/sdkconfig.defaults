# M5Stack Tab5 (ESP32-P4NRW32: 16MB flash / 32MB PSRAM)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# Console over the USB-C port (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# FAT (SD card): long file names
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# file names on the SD card are UTF-8 (e.g. 出典とライセンス.txt sent with tools/sdput.py)
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Silence the certificate bundle (not used)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n

# ESP32-P4 bootloader is larger than 0x6000; move the partition table up
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# Tab5 units ship with ESP32-P4 silicon v1.x; allow revisions below v3
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
